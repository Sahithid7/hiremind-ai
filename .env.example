APP_NAME=HireMind AI
ENVIRONMENT=local
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (development)
DATABASE_URL=sqlite:///./hiremind_local.db

# Production PostgreSQL (uncomment for Render/production)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CREATE_TABLES_ON_STARTUP=true

# ── AI Keys ───────────────────────────────────────────────────────────────────
# Groq (free) — get at console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Gemini (free) — get at aistudio.google.com — used for PDF extraction
GEMINI_API_KEY=your_gemini_key_here

# OpenAI (optional — only needed for /parse-ai and /rewrite endpoints)
OPENAI_API_KEY=sk-optional
OPENAI_MODEL=gpt-4o-mini
